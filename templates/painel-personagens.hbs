<div class="gl-painel-conteudo">
	<header class="gl-painel-topo">
		<i class="fa-solid fa-compass"></i>
		<strong>Expedição</strong>
		<span class="gl-painel-acoes">
			{{#unless minimizado}}<a data-action="detalhar" class="{{#if detalhado}}ativo{{/if}}" data-tooltip="{{#if detalhado}}Esconder as perícias{{else}}Mostrar as perícias treinadas{{/if}}"><i class="fa-solid fa-id-card"></i></a>{{/unless}}
			{{#unless minimizado}}<a data-action="recolher" data-tooltip="{{#if recolhido}}Mostrar Defesa e condições{{else}}Mostrar só vida e mana{{/if}}"><i class="fa-solid {{#if recolhido}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i></a>{{/unless}}
			<a data-action="minimizar" data-tooltip="{{#if minimizado}}Mostrar o painel{{else}}Minimizar o painel{{/if}}"><i class="fa-solid {{#if minimizado}}fa-window-maximize{{else}}fa-window-minimize{{/if}}"></i></a>
		</span>
	</header>
	<ul class="gl-painel-lista">
		{{#each personagens}}
		<li class="gl-painel-item {{#if daVez}}da-vez{{/if}} {{#if caido}}caida{{/if}}" data-actor="{{id}}">
			<img class="gl-painel-retrato" src="{{img}}" alt="" data-action="abrirFicha" data-tooltip="Abrir a ficha de {{nome}}">
			<div class="gl-painel-corpo">
				<div class="gl-painel-linha">
					<a class="gl-painel-nome" data-action="focar" data-tooltip="Centralizar no token">{{#if daVez}}<i class="fa-solid fa-play"></i> {{/if}}{{nome}}</a>
					{{#if jogador}}<span class="gl-painel-jogador">{{jogador}}</span>{{/if}}
				</div>
				{{#each barras}}
				<div class="gl-barra gl-barra-{{tipo}} faixa-{{faixa}}" data-tooltip="{{dica}}">
					<span class="gl-barra-rotulo">{{rotulo}}</span>
					<span class="gl-barra-trilho"><span class="gl-barra-nivel" style="width: {{pct}}%"></span></span>
					<span class="gl-barra-valor">{{texto}}</span>
				</div>
				{{/each}}
				<div class="gl-painel-detalhe gl-painel-dados">
					{{#if defesa}}<span data-tooltip="Defesa"><i class="fa-solid fa-shield-halved"></i> {{defesa}}</span>{{/if}}
					{{#each condicoes}}<img class="gl-painel-condicao" src="{{img}}" alt="{{nome}}" data-tooltip="{{nome}}">{{/each}}
					{{#if maisCondicoes}}<span data-tooltip="Outras condições">+{{maisCondicoes}}</span>{{/if}}
				</div>
				{{#if @root.detalhado}}
				{{#if pericias.length}}
				<ul class="gl-painel-pericias" data-tooltip="Perícias treinadas">
					{{#each pericias}}<li><span>{{nome}}</span>{{#if bonus}} <strong>{{bonus}}</strong>{{/if}}</li>{{/each}}
				</ul>
				{{else}}
				<p class="gl-painel-vazio">Nenhuma perícia treinada na ficha.</p>
				{{/if}}
				{{/if}}
			</div>
		</li>
		{{/each}}
	</ul>
</div>
